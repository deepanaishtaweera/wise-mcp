# Required. Wise > Settings > Connect and manage apps > API tokens (business account).
WISE_API_TOKEN=

# sandbox (default) or production
WISE_ENV=sandbox

# read (default) | write (create recipients/transfers, cancel) | payments (also fund transfers = send money)
WISE_ACCESS=read

# Optional default profile so agents can skip profileId
WISE_PROFILE_ID=

# Optional: RSA private key for SCA (UK/EEA funding, statements). Path or inline PEM.
WISE_PRIVATE_KEY_PATH=
# WISE_PRIVATE_KEY=

# HTTP mode only (ChatGPT / remote clients)
MCP_AUTH_TOKEN=
PORT=3000
