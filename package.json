{
  "name": "@dishtaweera/wise-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Wise (TransferWise) API: balances, quotes, recipients and transfers for Claude, ChatGPT and other agents",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "wise-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Deepana Ishtaweera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepanaishtaweera/wise-mcp.git"
  },
  "homepage": "https://github.com/deepanaishtaweera/wise-mcp#readme",
  "bugs": {
    "url": "https://github.com/deepanaishtaweera/wise-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wise",
    "transferwise",
    "banking",
    "exchange-rates",
    "claude",
    "chatgpt"
  ]
}
